<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The debug lab can trust a user-installed mitmproxy CA for Android-managed HTTPS. -->
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
